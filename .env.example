# INIT
NODE_ENV=development
PORT=8000
# Public base URL of this API; also used as the allowed CORS origin
URL=http://localhost:${PORT}

# DATABASE
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/your_db_name"
# E2E database (compose exposes db-test on host port 5433)
DB_TEST_NAME=your_db_test_name
DATABASE_TEST_URL="postgresql://your_db_user:your_db_password@localhost:5433/your_db_test_name"

# GOOGLE OAUTH - From Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=${URL}/api/auth/google/callback

# JWT
JWT_ACCESS_SECRET=your-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-random-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Username change cooldown in days (0 = disabled, e.g. for local testing)
USERNAME_CHANGE_COOLDOWN_DAYS=0